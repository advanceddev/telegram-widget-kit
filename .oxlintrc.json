{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off",
    "style": "off"
  },
  "env": { "browser": true, "es2022": true },
  "ignorePatterns": ["dist/**", "node_modules/**"],
  "rules": {
    "typescript/no-explicit-any": "off",
    "no-console": "off"
  }
}
